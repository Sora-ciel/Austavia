.firebase/

# emulator scratch: an ASCII temp dir Java can open a socket in, plus the
# debug logs the emulators drop in the working directory
.emulator-tmp/
*-debug.log

# packaged installers, staged for a GitHub release
release/

# old copies of src/ kept around by hand. Untracked and meant to stay that way:
# a release's `git add -A` swept both into the version-bump commit once — 106
# files instead of three — and it was only caught because the commit was read
# before it was pushed.
src let's say version 4/
version 5 src/

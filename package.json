{
  "name": "austavia",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node --test \"test/**/*.test.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "test:rules": "node scripts/emulator.mjs exec --only database,storage,auth \"node --test --test-concurrency=1 test-rules/**/*.test.js\"",
    "emulators": "node scripts/emulator.mjs start --only database,functions,storage,auth",
    "deploy:rules": "npm run test:rules && firebase deploy --only database,storage",
    "deploy:rules:staging": "npm run test:rules && firebase deploy --only database,storage --project staging",
    "tauri": "tauri",
    "test:triggers": "node scripts/emulator.mjs exec --only functions,database,storage,auth \"node --test --test-concurrency=1 test-triggers/**/*.test.js\"",
    "dev:staging": "vite dev --mode staging --port 5174 --strictPort",
    "build:staging": "vite build --mode staging"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.9.4",
    "firebase": "^12.18.0",
    "svelte": "^5.28.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@tauri-apps/api": "~2.6.0",
    "@tiptap/core": "^3.0.7",
    "@tiptap/extension-color": "^3.0.7",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-style": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "html2canvas-pro": "^2.3.9",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "markdown-it": "^14.3.0",
    "music-metadata": "^11.15.0",
    "tiptap-markdown": "^0.9.0"
  }
}

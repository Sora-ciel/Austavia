<!--
  ** This is NOT the file that matters. See capacitor_bridge_layout_main.xml. **

  Capacitor still ships a layout by this name, but it stopped inflating it:
  BridgeActivity calls setContentView(R.layout.capacitor_bridge_layout_main).
  So this override merges cleanly, builds cleanly, and does nothing at all.

  It is kept only because Capacitor still ships the name, so overriding it costs
  nothing and covers any path that might still reach for it. It is left here
  with this comment rather than deleted because its silence is the trap: when
  the keyboard stopped being told the app accepts pictures, checking this file
  showed our WebView named in the merged resources and looked like a pass. It
  was the wrong file. test/capacitorLayout.test.js now reads Capacitor's source
  and fails if the name it really inflates is not one we override.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.sora.austavia.ImagePasteWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

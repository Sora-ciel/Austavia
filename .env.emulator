# The local Firebase emulator, for the two-device sync tests (npm run
# test:sync). A `demo-` project exists only in the emulator, so nothing here
# can reach a real project, and none of it is a secret.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-arial.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-arial
VITE_FIREBASE_STORAGE_BUCKET=demo-arial.appspot.com
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_DB_URL=https://demo-arial-default-rtdb.firebaseio.com
VITE_FIREBASE_SYNC_NAMESPACE=default
